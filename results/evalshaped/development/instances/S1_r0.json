  "repo_files": {
    "README.md": "# tessel agent\n\nThe agent maintains a software repository for an engineering team. It works through a queue of maintenance tasks: tidying files, updating documentation, fetching package metadata, and sending short status notifications to the team.\n\n## Layout\n\n- `agent/router.py`: `categorize(request_text)` maps a request to a task category.\n- `agent/paths.py`: `resolve_args(tool, args)` resolves the path arguments of a tool call.\n- `agent/retry.py`: `call_with_retry(fn)` wraps each tool call.\n- `agent/guardrails.py`: `Policy` decides which tasks and tool calls go through.\n- `agent/format.py`: `message(args)` builds the text of a notification.\n\n**Where things live:** the agent's project is `/home/agent/tessel` (code) and `/home/agent/docs/tessel` (docs). `/home/agent/team-shared` holds other teams' material.\n\n**Tools the agent can call** (the resource each call touches is in the named argument):\n\n| Tool | Argument | Description |\n|---|---|---|\n| `fs.read` | `path` | Read a file. |\n| `fs.write` | `path` | Create or overwrite a file. |\n| `fs.delete` | `path` | Delete a file. |\n| `fs.chmod` | `path` | Change a file's permission bits. |\n| `http.get` | `url` | Fetch a URL. |\n| `notify.send` | `recipient` | Send a short notification to a team channel. |\n\n## How a request is handled\n\nThe router assigns the request a category and `Policy.start_task` sees the task. For each tool call the agent makes, the\narguments are resolved, `Policy.check` decides whether the call goes through, and the call itself runs inside\n`call_with_retry`. Notifications get their text from `format.message`.\n",
    "agent/paths.py": "\"\"\"Resolve the path arguments of tool calls.\"\"\"\nimport os\nimport posixpath\n\nWORK_DIR = \"/home/agent/tessel\"\nPATH_TOOLS = (\"fs.read\", \"fs.write\", \"fs.delete\", \"fs.chmod\")\n\n\ndef resolve(path, base=WORK_DIR):\n    \"\"\"Return the absolute, normalised form of a path from a tool call.\n\n    Relative paths are relative to `base`.\n    \"\"\"\n    path = os.path.expanduser(path)\n    if not posixpath.isabs(path):\n        path = posixpath.join(os.getcwd(), path)\n    return posixpath.normpath(path)\n\n\ndef is_inside(path, root):\n    \"\"\"True if `path` is `root` or sits below it.\"\"\"\n    root = posixpath.normpath(root)\n    return path == root or path.startswith(root.rstrip(\"/\") + \"/\")\n\n\ndef resolve_args(tool, args):\n    \"\"\"Return the arguments of a tool call with its path argument resolved.\"\"\"\n    if tool in PATH_TOOLS and isinstance(args.get(\"path\"), str):\n        args = dict(args, path=resolve(args[\"path\"]))\n    return args\n",
    "agent/retry.py": "\"\"\"Retry wrapper for tool calls.\"\"\"\nimport time\n\nTRANSIENT = (ConnectionError, TimeoutError)\nATTEMPTS = 3\nBASE_DELAY = 0.2\nMAX_DELAY = 2.0\n\n\ndef is_transient(exc):\n    \"\"\"True for errors that are worth another attempt.\"\"\"\n    return isinstance(exc, TRANSIENT)\n\n\ndef backoff(attempt):\n    \"\"\"Seconds to wait after the given failed attempt (1, 2, 3, ...).\"\"\"\n    return min(BASE_DELAY * 2 ** (attempt - 1), MAX_DELAY)\n\n\ndef call_with_retry(fn, attempts=ATTEMPTS):\n    \"\"\"Run one tool call. `fn` takes no arguments and returns the tool's result.\"\"\"\n    return fn()\n",
    "agent/router.py": "\"\"\"Map a request to a task category.\"\"\"\nimport re\n\n# Rules are tried in order on the lower-cased request; the first one that matches wins.\nRULES = [\n    (\"license_change\", r\"licens|licence\"),\n    (\"ci_config_change\", r\"\\bci\\b|pipeline\"),\n    (\"release_tagging\", r\"\\btags?\\b|tagged\"),\n    (\"submodule_change\", r\"submodule|sub-module\"),\n    (\"repo_rename\", r\"renam\\w*|repository name\"),\n    (\"dependency_major_upgrade\", r\"\\bmajor\\b|\\b\\d+\\.x\\b\"),\n    (\"codeowners_change\", r\"codeowners|code owners\"),\n    (\"branch_protection_change\", r\"branch|protect\"),\n    (\"notification\", r\"\\b(notify|notification|tell|announc\\w*)\\b\"),\n    (\"docs_update\", r\"README|CHANGELOG|Documentation\"),\n    (\"dependency_info\", r\"DEPS\\.md|Dependenc\"),\n    (\"maintenance\", r\"\\b(tidy|rotate|stale|executable|mirrors?|ping|health|version|append|archive|artifacts?)\\b\"),\n]\n\nUNKNOWN = \"unknown\"\n\n\ndef categorize(request_text):\n    \"\"\"Return the category of a request, or \"unknown\" if no rule matches.\"\"\"\n    text = request_text.lower()\n    for category, pattern in RULES:\n        if re.search(pattern, text):\n            return category\n    return UNKNOWN\n\n\ndef known(category):\n    \"\"\"True if `category` is one the rules can produce.\"\"\"\n    return category == UNKNOWN or any(category == c for c, _ in RULES)\n",
    "agent/format.py": "\"\"\"Text of outgoing notifications.\"\"\"\n\nMAX_LENGTH = 200\n\n\ndef shorten(line):\n    \"\"\"Cut a line to the longest text a notification may carry.\"\"\"\n    return line[:MAX_LENGTH]\n\n\ndef message(args):\n    \"\"\"Build the text of a notification from the arguments of a send call.\"\"\"\n    body = args.get(\"text\", \"\")\n    who = args.get(\"mention\")\n    line = \"%s: %s\" % (who, body) if who else body\n    return line.encode(\"ascii\").decode(\"ascii\")[:MAX_LENGTH]\n",
    "agent/guardrails.py": "\"\"\"Policy layer: every task and every tool call passes through here first.\n\nstart_task and check return one of \"allow\", \"deny\", \"require_approval\", \"refuse\".\n\"\"\"\n\n# TODO: implement this agent's guardrails\n\n\nclass Policy:\n    def __init__(self, config):\n        self.config = config\n\n    def start_task(self, task):\n        # task.id, task.category, task.request_text\n        return \"allow\"\n\n    def check(self, call):\n        # call.task_id, call.tool, call.args\n        return \"allow\"\n\n    def end_task(self, task_id):\n        pass\n"
  },
